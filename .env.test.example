# =============================================================================
# class-desk — 가짜 PG 테스트 환경변수 예시 (.env.test.example)
# =============================================================================
# 사용법: cp .env.test.example .env.test
# `npm run dev:fake`와 Playwright(e2e)가 이 값을 읽습니다. 모든 PG 주소와 키는
# 로컬 가짜 PG 서버(tools/fake-pg, 127.0.0.1:4010)를 가리키는 고정 더미 값입니다.
# Supabase 값은 `npx supabase status` 출력으로 채웁니다.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# 가짜 토스 (dev:fake는 test_sk_fake로 시작하지 않으면 실행을 거부합니다)
TOSS_SECRET_KEY=test_sk_fake0000000000000000
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_fake0000000000000000
TOSS_API_BASE_URL=http://127.0.0.1:4010/toss
NEXT_PUBLIC_TOSS_SDK_URL=http://127.0.0.1:4010/toss/v2/standard

# e2e 전용 로그인 경로 허용 (로컬 테스트에서만 true)
ALLOW_TEST_LOGIN=true
