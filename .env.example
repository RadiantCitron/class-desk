# =============================================================================
# class-desk — 환경변수 예시 (.env.example)
# =============================================================================
# 사용법: cp .env.example .env.local 후 실제 로컬 값을 채웁니다.
#
# 표시:
#   [필수] 없으면 서버가 정상 동작하지 않습니다.
#   [선택] 비워두면 해당 기능이 비활성화됩니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (DB 및 인증) [필수]
# -----------------------------------------------------------------------------
# 로컬 Supabase(Docker) 구동 시 `npx supabase status`의 출력값을 입력합니다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_local_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_local_service_role_key_here

# -----------------------------------------------------------------------------
# 2. 토스페이먼츠 (결제 연동) [선택]
# -----------------------------------------------------------------------------
# 토스페이먼츠 개발자센터에서 발급받은 테스트 키를 입력합니다.
# 로컬 개발 환경에서는 반드시 테스트 키(test_gck_ / test_gsk_)만 사용해야 합니다.
# 비워두거나 `npm run dev:fake` 실행 시 가짜 PG 모의 서버(127.0.0.1:4010)를 사용합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_your_toss_client_key
TOSS_SECRET_KEY=test_gsk_your_toss_secret_key

# -----------------------------------------------------------------------------
# 3. 디스코드 연동 [선택]
# -----------------------------------------------------------------------------
# 수강생 역할 자동 부여 및 알림 발송용 Discord Bot/Webhook 정보입니다.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_ROLE_ID=your_discord_student_role_id_here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# -----------------------------------------------------------------------------
# 4. 앱 설정 [필수]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
